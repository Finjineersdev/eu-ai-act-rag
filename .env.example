# Required: your Anthropic API key (never commit .env)
ANTHROPIC_API_KEY=

# Optional
# MODEL=claude-opus-5-5              # answering model (default)
# REWRITE_MODEL=claude-haiku-5-5     # model that rewrites the question into a search query

# Public demo mode only (see README, Live demo)
# DEMO=1                             # saved examples, Haiku for typed questions, rate limits, own-key field
# CLIENT_IP_HEADER=CF-Connecting-IP  # header the host's proxy sets to the visitor's address (Render)
# PROXY_HOPS=1                       # otherwise: how many proxies append to X-Forwarded-For
